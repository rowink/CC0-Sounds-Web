---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import AudioPlayer from "../../components/AudioPlayer.astro";

export function getStaticPaths() {
	// Scan all audio files from public/sounds/
	const allAudioFiles = Object.entries(import.meta.glob("/public/sounds/**/*.{ogg,mp3,wav}", { eager: true }));

	// Build a map of collection ID -> audio files
	const collectionFiles: Record<string, { name: string; src: string }[]> = {};

	for (const [path] of allAudioFiles) {
		// Path format: /public/sounds/{collection-id}/{subfolder/}filename.ext
		// Handle both /public/sounds/folder/file.ogg and /public/sounds/folder/subfolder/file.ogg
		const parts = path.replace("/public/sounds/", "").split("/");
		const collectionId = parts[0];
		const filename = parts[parts.length - 1];

		// Skip files without a valid collection folder
		if (!collectionId || !filename.match(/\.(ogg|mp3|wav)$/i)) continue;

		// Build the full relative path (including subdirectories)
		// parts = [collectionId, subfolder1, subfolder2, ..., filename]
		const fullPath = parts.slice(1).join("/"); // Everything after collectionId
		const src = `/sounds/${collectionId}/${fullPath}`;

		if (!collectionFiles[collectionId]) {
			collectionFiles[collectionId] = [];
		}
		collectionFiles[collectionId].push({
			name: fullPath, // Show full path as name for clarity
			src,
		});
	}

	// Sort files by name
	for (const id of Object.keys(collectionFiles)) {
		collectionFiles[id].sort((a, b) => a.name.localeCompare(b.name));
	}

	// Generate paths for all collections that have audio files
	return Object.entries(collectionFiles).map(([id, files]) => ({
		params: { id },
		props: {
			collection: {
				id,
				name: id.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
				description: `${files.length} sound files`,
			},
			audioFiles: files,
		},
	}));
}

const { collection, audioFiles } = Astro.props;

// For now, show a message that the page needs to be generated
---

<BaseLayout title={collection.name}>
	<Header />

	<main>
		<h1 class="page-title">{collection.name}</h1>

		<nav class="breadcrumb">
			<a href="/">Collections</a>
			<span class="separator">/</span>
			<span class="current">{collection.name}</span>
		</nav>

		<section class="collection-header">
			<div class="header-content">
				<p class="collection-description">{collection.description}</p>
			</div>

			<div class="header-actions">
				<button id="play-all-btn" class="btn btn-secondary" title="Play all loaded files">
					<svg id="play-all-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
						<polygon points="5,3 19,12 5,21"></polygon>
					</svg>
					<svg id="stop-all-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="display:none">
						<rect x="6" y="4" width="4" height="16"></rect>
						<rect x="14" y="4" width="4" height="16"></rect>
					</svg>
					<span id="play-all-text">Play All</span>
				</button>
				<a href={`/download/${collection.id}`} class="btn btn-primary">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
						<polyline points="7,10 12,15 17,10"></polyline>
						<line x1="12" y1="15" x2="12" y2="3"></line>
					</svg>
					Download All
				</a>
			</div>
		</section>

			<section class="audio-list">
			<div class="list-header">
				<h2 class="list-title">Sound Files</h2>
				<div class="list-header-row">
					<div class="search-wrapper">
						<svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input id="search-input" type="text" class="search-input" placeholder="Search files..." aria-label="Search files" spellcheck="false">
					</div>
					<span class="list-count">
						<span id="shown-count">{Math.min(500, audioFiles.length)}</span> / <span id="total-count">{audioFiles.length}</span> files
						{audioFiles.length > 500 && (
							<button id="load-all-btn" class="load-all-icon" title="Load all files">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<polyline points="7,13 12,18 17,13"></polyline>
									<polyline points="7,6 12,11 17,6"></polyline>
								</svg>
							</button>
						)}
					</span>
				</div>
			</div>

			<div class="player-list" id="player-list">
				{audioFiles.slice(0, 500).map((file, index) => <AudioPlayer id={`audio-${index}`} name={file.name} src={file.src} />)}
			</div>

			<div id="infinite-scroll-sentinel" class="scroll-sentinel">
				<svg class="spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="10" opacity="0.25" />
					<path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round">
						<animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite" />
					</path>
				</svg>
				<span>Scroll to load more...</span>
			</div>

			<div id="no-results" class="no-results" style="display:none">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					<line x1="8" y1="11" x2="14" y2="11"></line>
				</svg>
				<p>No files match your search</p>
			</div>

			<div class="empty-state">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<path d="M9 18V5l12-2v13"></path>
					<circle cx="6" cy="18" r="3"></circle>
					<circle cx="18" cy="16" r="3"></circle>
				</svg>
				<p>Audio files are loaded dynamically based on folder contents.</p>
				<p class="hint">The site will scan your audio folders to generate this page.</p>
			</div>
		</section>

		<!-- Embed all audio file data for client-side infinite scroll -->
		<div id="audio-files-data" style="display:none">{JSON.stringify(audioFiles)}</div>
	</main>

	<Footer />
</BaseLayout>

<style>
	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem 3rem;
	}

	.page-title {
		font-family: var(--font-display);
		font-size: 1.5rem;
		color: var(--color-accent);
		margin-bottom: 0.5rem;
		padding-top: 0.5rem;
		font-weight: 600;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.breadcrumb a {
		color: var(--color-text-muted);
		transition: color 0.2s;
	}

	.breadcrumb a:hover {
		color: var(--color-accent);
	}

	.separator {
		color: var(--color-text-muted);
	}

	.current {
		color: var(--color-text);
	}

	.collection-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.collection-title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--color-text);
		margin-bottom: 0.25rem;
		font-weight: 500;
	}

	.collection-description {
		color: var(--color-text-muted);
		font-size: 0.9375rem;
	}

	.header-actions {
		display: flex;
		gap: 0.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.5rem 0.75rem;
		font-family: var(--font-display);
		font-size: 0.9375rem;
		border: 1px solid;
		transition: all 0.15s;
	}

	.btn svg {
		width: 14px;
		height: 14px;
	}

	.btn-primary {
		background: var(--color-accent);
		color: #ffffff;
		border-color: var(--color-accent-dim);
	}

	.btn-primary:hover {
		background: var(--color-accent-dim);
	}

	.btn-secondary {
		background: none;
		color: var(--color-text);
		border-color: var(--color-border);
	}

	.btn-secondary:hover {
		background: var(--color-bg-secondary);
		border-color: var(--color-accent);
	}

	#play-all-btn.playing {
		background: var(--color-accent);
		color: #fff;
		border-color: var(--color-accent-dim);
	}

	.list-header {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.list-header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	.list-title {
		font-family: var(--font-display);
		font-size: 1.125rem;
		color: var(--color-text);
		font-weight: 500;
	}

	.search-wrapper {
		position: relative;
		flex: 1;
		max-width: 320px;
		min-width: 120px;
	}

	.search-icon {
		position: absolute;
		left: 8px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--color-text-muted);
		pointer-events: none;
	}

	.search-input {
		width: 100%;
		padding: 0.35rem 0.75rem 0.35rem 28px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text);
		background: var(--color-bg-secondary);
		border: 1px solid var(--color-border);
		border-radius: 4px;
		outline: none;
		transition: border-color 0.15s ease;
		box-sizing: border-box;
	}

	.search-input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.7;
	}

	.search-input:focus {
		border-color: var(--color-accent);
	}

	.list-count {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.no-results {
		text-align: center;
		padding: 2.5rem 1.5rem;
		color: var(--color-text-muted);
	}

	.no-results svg {
		width: 40px;
		height: 40px;
		margin-bottom: 0.75rem;
		opacity: 0.5;
	}

	.no-results p {
		font-size: 0.9375rem;
	}

	.load-all-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		padding: 2px;
		cursor: pointer;
		color: var(--color-text-muted);
		transition: all 0.15s ease;
		line-height: 0;
	}

	.load-all-icon:hover {
		color: var(--color-text);
		border-color: var(--color-accent);
		background: var(--color-bg-secondary);
	}

	.player-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	@media (max-width: 768px) {
		.player-list {
			grid-template-columns: 1fr;
		}
	}

	.empty-state {
		text-align: center;
		padding: 2.5rem 1.5rem;
		background: var(--color-bg-secondary);
		border: 1px dashed var(--color-border);
	}

	.empty-state svg {
		width: 48px;
		height: 48px;
		color: var(--color-text-muted);
		margin-bottom: 0.75rem;
	}

	.empty-state p {
		color: var(--color-text-muted);
		margin-bottom: 0.25rem;
		font-size: 0.9375rem;
	}

	.empty-state .hint {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.scroll-sentinel {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 2rem 0;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.scroll-sentinel .spinner {
		width: 18px;
		height: 18px;
		animation: spin 1s linear infinite;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	@media (max-width: 640px) {
		.collection-header {
			flex-direction: column;
		}

		.collection-title {
			font-size: 1.25rem;
		}

		.header-actions {
			width: 100%;
		}

		.btn {
			flex: 1;
			justify-content: center;
		}

		.search-wrapper {
			max-width: none;
		}
	}
</style>

<script>
	(function () {
		const dataEl = document.getElementById('audio-files-data');
		const list = document.getElementById('player-list');
		const sentinel = document.getElementById('infinite-scroll-sentinel');
		const shownCountEl = document.getElementById('shown-count');
		const totalCountEl = document.getElementById('total-count');
		const searchInput = document.getElementById('search-input');
		const noResultsEl = document.getElementById('no-results');

		if (!dataEl || !list || !sentinel) {
			console.error('Infinite scroll: required DOM elements not found');
			return;
		}

		/** @type {{ name: string; src: string }[]} */
		let ALL_FILES;
		try {
			ALL_FILES = JSON.parse(dataEl.textContent);
		} catch (e) {
			console.error('Infinite scroll: failed to parse audio file data', e);
			return;
		}

		const BATCH_SIZE = 500;
		let filteredFiles = ALL_FILES;
		let offset = Math.min(BATCH_SIZE, ALL_FILES.length);
		let isLoading = false;

		/**
		 * Build the HTML for a single audio player element
		 */
		function createPlayerElement(file, index) {
			const div = document.createElement('div');
			div.className = 'audio-player';
			div.dataset.id = `audio-${index}`;
			div.dataset.src = file.src;
			div.dataset.name = file.name;

			const playIcon = '<svg class="play-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5,3 19,12 5,21"/></svg>';
			const pauseIcon = '<svg class="pause-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
			const downloadIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';

			div.innerHTML = [
				'<div class="filename" title="' + file.name.replace(/"/g, '&quot;').replace(/</g, '&lt;') + '">',
				file.name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'),
				'</div>',
				'<div class="player-controls">',
				'<button class="play-btn" aria-label="Play">' + playIcon + pauseIcon + '</button>',
				'<div class="waveform"><div class="progress-bar"><div class="progress-fill"></div></div></div>',
				'<div class="time-display"><span class="current-time">0:00</span><span class="time-separator">/</span><span class="duration">--:--</span></div>',
				'<button class="download-btn" aria-label="Download" title="Download">' + downloadIcon + '</button>',
				'</div>'
			].join('');

			return div;
		}

		/**
		 * Initialize audio playback for a single player element.
		 */
		function initPlayer(player) {
			const playBtn = player.querySelector('.play-btn');
			const progressBar = player.querySelector('.progress-bar');
			const progressFill = player.querySelector('.progress-fill');
			const currentTimeEl = player.querySelector('.current-time');
			const durationEl = player.querySelector('.duration');
			const downloadBtn = player.querySelector('.download-btn');

			if (!playBtn || !progressBar || !progressFill) return;

			const src = player.dataset.src || '';
			const name = player.dataset.name || '';
			const audio = new Audio(src);
			let isPlaying = false;

			function formatTime(seconds) {
				const mins = Math.floor(seconds / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 100);
				return mins + ':' + secs.toString().padStart(2, '0') + '.' + ms.toString().padStart(2, '0');
			}

			function togglePlay() {
				if (isPlaying) {
					audio.pause();
				} else {
					document.querySelectorAll('.audio-player.playing').forEach(function (p) {
						if (p !== player) {
							const pAudio = p.querySelector('audio');
							if (pAudio) { pAudio.pause(); p.classList.remove('playing'); }
						}
					});
					audio.play();
				}
			}

			audio.addEventListener('play', function () { isPlaying = true; player.classList.add('playing'); });
			audio.addEventListener('pause', function () { isPlaying = false; player.classList.remove('playing'); });
			audio.addEventListener('timeupdate', function () {
				var progress = (audio.currentTime / audio.duration) * 100;
				progressFill.style.width = progress + '%';
				if (currentTimeEl) currentTimeEl.textContent = formatTime(audio.currentTime);
			});
			audio.addEventListener('loadedmetadata', function () {
				if (durationEl) durationEl.textContent = formatTime(audio.duration);
			});
			audio.addEventListener('ended', function () {
				isPlaying = false;
				player.classList.remove('playing');
				progressFill.style.width = '0%';
				if (currentTimeEl) currentTimeEl.textContent = '0:00';
				player.dispatchEvent(new CustomEvent('audio-ended', { bubbles: true }));
			});

			playBtn.addEventListener('click', togglePlay);
			progressBar.addEventListener('click', function (e) {
				var rect = progressBar.getBoundingClientRect();
				audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
			});
			downloadBtn && downloadBtn.addEventListener('click', function () {
				var a = document.createElement('a');
				a.href = src;
				a.download = name;
				a.target = '_blank';
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
			});
		}

		/**
		 * Load the next batch of audio players and append them to the list
		 */
		function loadMore() {
			if (isLoading || offset >= filteredFiles.length) return;
			isLoading = true;

			try {
				var end = Math.min(offset + BATCH_SIZE, filteredFiles.length);
				var fragment = document.createDocumentFragment();

				for (var i = offset; i < end; i++) {
					fragment.appendChild(createPlayerElement(filteredFiles[i], i));
				}

				list.appendChild(fragment);

				// Initialize each newly added player
				var allPlayers = list.querySelectorAll('.audio-player');
				for (var i = offset; i < end; i++) {
					initPlayer(allPlayers[i]);
				}

				offset = end;
				if (shownCountEl) shownCountEl.textContent = String(offset);

				// Hide sentinel when all files are loaded
				if (offset >= filteredFiles.length) {
					sentinel.style.display = 'none';
				}
			} catch (e) {
				console.error('Infinite scroll: loadMore error', e);
			} finally {
				isLoading = false;
			}
		}

		/**
		 * Load ALL remaining files at once
		 */
		function loadAll() {
			if (isLoading || offset >= filteredFiles.length) return;
			isLoading = true;

			try {
				var fragment = document.createDocumentFragment();
				for (var i = offset; i < filteredFiles.length; i++) {
					fragment.appendChild(createPlayerElement(filteredFiles[i], i));
				}

				list.appendChild(fragment);

				var allPlayers = list.querySelectorAll('.audio-player');
				for (var i = offset; i < filteredFiles.length; i++) {
					initPlayer(allPlayers[i]);
				}

				offset = filteredFiles.length;
				if (shownCountEl) shownCountEl.textContent = String(filteredFiles.length);
				sentinel.style.display = 'none';
			} catch (e) {
				console.error('Infinite scroll: loadAll error', e);
			} finally {
				isLoading = false;
			}
		}

		/**
		 * Perform search across all files and render matching results
		 */
		function performSearch() {
			var query = searchInput.value.trim().toLowerCase();

			if (!query) {
				filteredFiles = ALL_FILES;
			} else {
				filteredFiles = ALL_FILES.filter(function (f) {
					return f.name.toLowerCase().indexOf(query) !== -1;
				});
			}

			// Stop Play All if active
			if (isPlayingAll) stopPlayAll();

			// Reset and re-render
			offset = 0;
			list.innerHTML = '';
			noResultsEl.style.display = 'none';

			if (filteredFiles.length === 0) {
				noResultsEl.style.display = '';
				sentinel.style.display = 'none';
				if (shownCountEl) shownCountEl.textContent = '0';
				if (totalCountEl) totalCountEl.textContent = '0';
				if (loadAllBtn) loadAllBtn.style.display = 'none';
				return;
			}

			var firstBatch = Math.min(BATCH_SIZE, filteredFiles.length);
			var fragment = document.createDocumentFragment();
			for (var i = 0; i < firstBatch; i++) {
				fragment.appendChild(createPlayerElement(filteredFiles[i], i));
			}
			list.appendChild(fragment);

			var players = list.querySelectorAll('.audio-player');
			for (var i = 0; i < firstBatch; i++) {
				initPlayer(players[i]);
			}

			offset = firstBatch;
			if (shownCountEl) shownCountEl.textContent = String(offset);
			if (totalCountEl) totalCountEl.textContent = String(filteredFiles.length);

			if (loadAllBtn) {
				loadAllBtn.style.display = filteredFiles.length > BATCH_SIZE ? '' : 'none';
			}

			if (offset >= filteredFiles.length) {
				sentinel.style.display = 'none';
			} else {
				sentinel.style.display = '';
			}
		}

		/**
		 * Play All / Stop logic — plays currently loaded players sequentially
		 */
		var playQueue = [];
		var isPlayingAll = false;
		var currentTrackIndex = -1;

		function playAll() {
			var players = list.querySelectorAll('.audio-player');
			if (players.length === 0) return;

			playQueue = Array.from(players);
			isPlayingAll = true;
			currentTrackIndex = -1;
			updatePlayAllUI(true);
			playNextInQueue();
		}

		function playNextInQueue() {
			if (!isPlayingAll) return;
			currentTrackIndex++;
			if (currentTrackIndex >= playQueue.length) {
				stopPlayAll();
				return;
			}
			var player = playQueue[currentTrackIndex];
			var playBtn = player.querySelector('.play-btn');
			if (playBtn) playBtn.click();
		}

		function stopPlayAll() {
			isPlayingAll = false;
			playQueue = [];
			currentTrackIndex = -1;
			document.querySelectorAll('.audio-player.playing').forEach(function (p) {
				var btn = p.querySelector('.play-btn');
				if (btn) btn.click();
			});
			updatePlayAllUI(false);
		}

		function updatePlayAllUI(playing) {
			var btn = document.getElementById('play-all-btn');
			var playIcon = document.getElementById('play-all-icon');
			var stopIcon = document.getElementById('stop-all-icon');
			var text = document.getElementById('play-all-text');
			if (!btn || !text || !playIcon || !stopIcon) return;
			if (playing) {
				btn.classList.add('playing');
				playIcon.style.display = 'none';
				stopIcon.style.display = '';
				text.textContent = 'Stop';
			} else {
				btn.classList.remove('playing');
				playIcon.style.display = '';
				stopIcon.style.display = 'none';
				text.textContent = 'Play All';
			}
		}

		// Wire up Play All button
		var playAllBtn = document.getElementById('play-all-btn');
		if (playAllBtn) {
			playAllBtn.addEventListener('click', function () {
				if (isPlayingAll) {
					stopPlayAll();
				} else {
					playAll();
				}
			});
		}

		// Listen for audio-ended to advance the queue
		list.addEventListener('audio-ended', function () {
			if (isPlayingAll) {
				playNextInQueue();
			}
		});

		// Wire up the "Load All" button
		var loadAllBtn = document.getElementById('load-all-btn');
		if (loadAllBtn) {
			loadAllBtn.addEventListener('click', function () {
				loadAllBtn.style.display = 'none';
				loadAll();
			});
		}

		// Wire up search input
		if (searchInput) {
			searchInput.addEventListener('input', performSearch);
		}

		// Initial total count
		if (totalCountEl) totalCountEl.textContent = String(ALL_FILES.length);

		// Hide sentinel immediately if all files (or all filtered) fit in one batch
		if (filteredFiles.length <= BATCH_SIZE) {
			sentinel.style.display = 'none';
			return;
		}

		// Set up IntersectionObserver for infinite scroll
		var observer = new IntersectionObserver(function (entries) {
			if (entries[0].isIntersecting) {
				loadMore();
			}
		}, { rootMargin: '400px' });

		observer.observe(sentinel);

		// Fallback: if sentinel is already visible on load, trigger immediately
		if (sentinel.getBoundingClientRect().top < window.innerHeight + 400) {
			loadMore();
		}
	})();
</script>
